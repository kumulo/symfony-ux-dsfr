<div
        {{ attributes.defaults({
            class: 'fr-table' ~ (scrollable ? ' fr-table--no-scroll' : '') ~ (stickyHeader ? ' fr-table--sticky' : '')
        }) }}
>
    <table{% if id %} id="{{ id }}"{% endif %}{% if bordered %} class="fr-table--bordered"{% endif %}>
        {% if caption %}
            <caption>{{ caption }}</caption>
        {% endif %}

        {% if block('thead') is defined %}
            <thead>
            {% block thead %}{% endblock %}
            </thead>
        {% endif %}

        {% if block('tbody') is defined %}
            <tbody>
            {% block tbody %}{% endblock %}
            </tbody>
        {% endif %}
    </table>
</div>
