<div {{ attributes.defaults({ 'class': 'fr-alert fr-alert--' ~ type ~ (size == 'sm' ? ' fr-alert--sm' : '') }) }}>    
    {% if block('title') is defined and block('title') is not empty %}
        <h3 class="fr-alert__title">
            {% block title %}{% endblock %}
        </h3>
    {% endif %}
    {% block content %}{% endblock %}
    {% if closable %}
        <button title="Masquer le message"
                onclick="const alert = this.parentNode; alert.parentNode.removeChild(alert)"
                type="button"
                class="fr-btn--close fr-btn"
        >
            Masquer le message
        </button>
    {% endif %}
</div>
