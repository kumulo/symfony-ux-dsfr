<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-fr-scheme="light">
<head>
    <title>{% block title %}{% endblock %}</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% block head_meta %}{% endblock %}
    {% block stylesheets %}
        {{ block('stylesheets', '@UxDsfr/assets/' ~ ux_dsfr_integration_mode ~ '.html.twig') }}
    {% endblock %}
    {% block javascripts %}
        {{ block('javascripts', '@UxDsfr/assets/' ~ ux_dsfr_integration_mode ~ '.html.twig') }}
    {% endblock %}
</head>
<body>
{% block page %}
{% endblock %}
</body>
</html>
