<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-fr-scheme="light">
<head>
    <title>{% block title %}{% endblock %}</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% block head_meta %}{% endblock %}
    {% block stylesheets %}
        {{ encore_entry_link_tags('dsfr', null, 'dsfr') }}
    {% endblock %}
    {% block javascripts %}
        {{ encore_entry_script_tags('dsfr', null, 'dsfr') }}
    {% endblock %}
</head>
<body>
{% block page %}
{% endblock %}
</body>
</html>
