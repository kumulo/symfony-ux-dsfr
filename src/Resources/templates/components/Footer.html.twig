<footer {{ attributes.defaults({'class': 'fr-footer', 'role': 'contentinfo', 'id': 'footer'}) }}>
    <div class="fr-container">
        <div class="fr-footer__body">
            {# footer_brand takes a Footer:Logo whose content is markup, e.g. a name on two lines #}
            {% block footer_brand %}
                {% if logo_title %}
                    <twig:UxDsfr:Footer:Logo :link="service_link" :service_logo="service_logo" :service_title="service_title">{{ logo_title }}</twig:UxDsfr:Footer:Logo>
                {% else %}
                    <twig:UxDsfr:Footer:Logo :link="service_link" :service_logo="service_logo" :service_title="service_title"></twig:UxDsfr:Footer:Logo>
                {% endif %}
            {% endblock %}
            <div class="fr-footer__content">
                {% block footer_content %}
                    {% if description %}
                        <p class="fr-footer__content-desc">{{ description }}</p>
                    {% endif %}
                    {# Mandatory links, in this order #}
                    <ul class="fr-footer__content-list">
                        {% for domain in ['info.gouv.fr', 'service-public.gouv.fr', 'legifrance.gouv.fr', 'data.gouv.fr'] %}
                            <li class="fr-footer__content-item">
                                <a class="fr-footer__content-link" href="https://{{ domain }}" target="_blank" rel="noopener external" title="{{ domain }} - {{ 'utils.new_window'|trans({}, 'dsfr') }}">{{ domain }}</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endblock %}
            </div>
        </div>
        {% if partners %}
        <div class="fr-footer__partners">
            {% if partners.title is defined %}<h2 class="fr-footer__partners-title">{{ partners.title }}</h2>{% endif %}
            <div class="fr-footer__partners-logos">
                {% if partners.main is defined %}
                <div class="fr-footer__partners-main">
                    <twig:UxDsfr:Footer:PartnerLink :link="partners.main.link" :asset="partners.main.asset" :title="partners.main.title">
                    </twig:UxDsfr:Footer:PartnerLink>
                </div>
                {% endif %}
                {% if partners.subs is defined %}
                <div class="fr-footer__partners-sub">
                    <ul>
                        {% for partner in partners.subs %}
                        <li>
                            <twig:UxDsfr:Footer:PartnerLink :link="partner.link" :asset="partner.asset" :title="partner.title">
                            </twig:UxDsfr:Footer:PartnerLink>
                        </li>
                        {% endfor %}
                    </ul>
                </div>
                {% endif %}
            </div>
        </div>
        {% endif %}
        <div class="fr-footer__bottom">
            {% set footer_menu %}{% block footer_menu %}{% endblock %}{% endset %}
            {% if footer_menu %}
            {{ footer_menu }}
            {% endif %}
            <div class="fr-footer__bottom-copy">
                {% block footer_copy %}
                    <p>{{ 'footer.license'|trans({}, 'dsfr') }} <a href="https://github.com/etalab/licence-ouverte/blob/master/LO.md" target="_blank" rel="noopener external" title="{{ 'footer.license_link'|trans({}, 'dsfr') }} - {{ 'utils.new_window'|trans({}, 'dsfr') }}">{{ 'footer.license_link'|trans({}, 'dsfr') }}</a></p>
                {% endblock %}
            </div>
        </div>
    </div>
</footer>