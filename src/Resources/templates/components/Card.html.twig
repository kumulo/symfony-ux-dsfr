{% set title %}{% block card_title %}{% endblock %}{% endset %}
<div {{ attributes.defaults({'class': 'fr-card ' ~ link_type}) }}>
    <div class="fr-card__body">
        <div class="fr-card__content">
            <h3 class="fr-card__title">
                {% if href %}<a href="{{ href }}">{% endif %}
                    {{ title }}
                {% if href %}</a>{% endif %}
            </h3>
            {% block content %}
                <p class="fr-card__desc">Description de la carte</p>
            {% endblock %}
            {% if file_size or file_type %}
            <div class="fr-card__end">
                <p class="fr-card__detail">{{ {file_type, file_size}|join(' - ') }}</p>
            </div>
            {% endif %}
        </div>
    </div>
    {% if card_header %}
        <div class="fr-card__header">
            <div class="fr-card__img">
                <img class="fr-responsive-img" src="{{ card_header }}" alt="{{ card_header_alt }}">
            </div>
        </div>
    {% endif %}
</div>
