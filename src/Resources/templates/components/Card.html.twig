<div {{ attributes.defaults({'class': 'fr-card ' ~ link_type}) }}>
    <div class="fr-card__body">
        <div class="fr-card__content">
            {% block card_content %}
                <h3 class="fr-card__title">
                    <a href="#">Titre de la carte</a>
                </h3>
                <p class="fr-card__desc">Description de la carte</p>
            {% endblock %}
            <!-- download <div class="fr-card__end">
                <p class="fr-card__detail">PDF - 48 ko</p>
            </div> -->
        </div>
    </div>
    {% if block('card_header') is defined %}
        <div class="fr-card__header">
            {% block card_header %}
            <div class="fr-card__img">
                <img class="fr-responsive-img" src="{{ asset('/bundles/symfonyuxdsfr/images/placeholder.16x9.png') }}" alt="[À MODIFIER - vide ou texte alternatif de l’image]">
            </div>
            {% endblock %}
        </div>
    {% endif %}
</div>