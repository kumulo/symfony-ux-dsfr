{% extends "@UxDsfr/bootstrap/components.html.twig" %}

{% block text_content %}
    <h2 class="fr-h3">Alert</h2>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
            <twig:UxDsfr:Alert>
                Contenu de l'alerte
            </twig:UxDsfr:Alert>
            <twig:UxDsfr:Alert type="warning"/>
            <twig:UxDsfr:Alert type="error">
                {% block title %}Erreur{% endblock %}
                Il s'est passé quelque chose
            </twig:UxDsfr:Alert>
            <twig:UxDsfr:Alert type="success">
                {% block title %}OK{% endblock %}
                Tout va bien
            </twig:UxDsfr:Alert>
        </div>
    </div>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Code snippel</h3>
        <div class="code-snippet">
            {% set code = "{% component 'UxDsfr:GouvLogo' %}
    {% block content %}
        Intitulé&lt;br&gt;officiel
    {% endblock %}
{% endcomponent %}" %}
            <pre><code class="language-twig">{{ code|raw }}</code></pre>
            {% set code = "&lt;twig:UxDsfr:Alert type=\"success\"&gt;
    {% block title %}OK{% endblock %}
    Tout va bien
&lt;/twig:UxDsfr:Alert&gt;" %}
            <pre><code class="language-html">{{ code|raw }}</code></pre>
        </div>
    </div>
{% endblock %}