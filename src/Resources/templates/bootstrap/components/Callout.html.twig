{% extends "@UxDsfr/bootstrap/components.html.twig" %}

{% block text_content %}
    <h2 class="fr-h3">Callout</h2>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
            <twig:UxDsfr:Callout>
                Ceci est un callout par défaut.
            </twig:UxDsfr:Callout>
            <twig:UxDsfr:Callout color="blue-ecume">
                Callout en bleu.
            </twig:UxDsfr:Callout>
        </div>
    </div>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Code snippel</h3>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Callout&gt;
    Ceci est un callout.
&lt;/twig:UxDsfr:Callout&gt;" %}
            <pre><code class="language-html">{{ code|raw }}</code></pre>
        </div>
    </div>
{% endblock %}
