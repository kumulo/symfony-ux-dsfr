{% extends "@UxDsfr/bootstrap/components.html.twig" %}

{% block text_content %}
    <h2 class="fr-h3">Quote</h2>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
            <twig:UxDsfr:Quote author="Auteur">
                Ceci est une citation.
            </twig:UxDsfr:Quote>
            <twig:UxDsfr:Quote author="Auteur" source="Source">
                Une autre citation avec source.
            </twig:UxDsfr:Quote>
        </div>
    </div>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Code snippel</h3>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Quote author=\"Auteur\"&gt;
    Ceci est une citation.
&lt;/twig:UxDsfr:Quote&gt;" %}
            <pre><code class="language-html">{{ code|raw }}</code></pre>
        </div>
    </div>
{% endblock %}
