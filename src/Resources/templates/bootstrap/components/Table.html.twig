{% extends "@UxDsfr/bootstrap/components.html.twig" %}

{% block text_content %}
    <h2 class="fr-h3">Table</h2>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
            <twig:UxDsfr:Table>
                {% block caption %}Tableau d'exemple{% endblock %}
                <thead>
                    <tr>
                        <th>Colonne 1</th>
                        <th>Colonne 2</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Donnée 1</td>
                        <td>Donnée 2</td>
                    </tr>
                    <tr>
                        <td>Donnée 3</td>
                        <td>Donnée 4</td>
                    </tr>
                </tbody>
            </twig:UxDsfr:Table>
        </div>
    </div>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Code snippel</h3>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Table&gt;
    {% block caption %}Tableau d'exemple{% endblock %}
    &lt;thead&gt;
        &lt;tr&gt;
            &lt;th&gt;Colonne 1&lt;/th&gt;
            &lt;th&gt;Colonne 2&lt;/th&gt;
        &lt;/tr&gt;
    &lt;/thead&gt;
    &lt;tbody&gt;
        &lt;tr&gt;
            &lt;td&gt;Donnée 1&lt;/td&gt;
            &lt;td&gt;Donnée 2&lt;/td&gt;
        &lt;/tr&gt;
        &lt;tr&gt;
            &lt;td&gt;Donnée 3&lt;/td&gt;
            &lt;td&gt;Donnée 4&lt;/td&gt;
        &lt;/tr&gt;
    &lt;/tbody&gt;
&lt;/twig:UxDsfr:Table&gt;" %}
            <pre><code class="language-html">{{ code|raw }}</code></pre>
        </div>
    </div>
{% endblock %}
