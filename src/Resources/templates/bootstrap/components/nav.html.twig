<twig:UxDsfr:Layout:SideMenu menu_title="Liste des composants">
    <twig:UxDsfr:Layout:SideMenuList>
        <twig:UxDsfr:Layout:SideMenuItem>
            {%- block link -%}
                <a href="{{ path('dsfr_components_Alert') }}"{% if app.current_route === 'dsfr_components_Alert' %} aria-current="page"{% endif %} class="fr-sidemenu__link">Alert</a>
            {%- endblock -%}
        </twig:UxDsfr:Layout:SideMenuItem>
        <twig:UxDsfr:Layout:SideMenuItem>
            {%- block link -%}
                <a href="{{ path('dsfr_components_GouvLogo') }}"{% if app.current_route === 'dsfr_components_GouvLogo' %} aria-current="page"{% endif %} class="fr-sidemenu__link">GouvLogo</a>
            {%- endblock -%}
        </twig:UxDsfr:Layout:SideMenuItem>
        <twig:UxDsfr:Layout:SideMenuItem>
            {%- block link -%}
                <a href="#" class="fr-sidemenu__link">test toto</a>
            {%- endblock -%}
        </twig:UxDsfr:Layout:SideMenuItem>
        {% set subcontent %}
            <twig:UxDsfr:Layout:SideMenuItem>
                {% block link %}
                    <a href="#" class="fr-sidemenu__link">SideMenu</a>
                {% endblock %}
            </twig:UxDsfr:Layout:SideMenuItem>
            <twig:UxDsfr:Layout:SideMenuItem>
                {% block link %}
                    <a href="#" class="fr-sidemenu__link">SideMenuList</a>
                {% endblock %}
            </twig:UxDsfr:Layout:SideMenuItem>
        {% endset %}
        {% set submun %}
            <twig:UxDsfr:Layout:SideMenuList>
                {{ subcontent }}
            </twig:UxDsfr:Layout:SideMenuList>
        {% endset %}
        <twig:UxDsfr:Layout:SideMenuItem>
            {% block submenu %}
            {{ submun }}
            {% endblock %}
        </twig:UxDsfr:Layout:SideMenuItem>
    </twig:UxDsfr:Layout:SideMenuList>
</twig:UxDsfr:Layout:SideMenu>