{% extends "@UxDsfr/bootstrap/components.html.twig" %}

{% block text_content %}
    <h2 class="fr-h3">Tag</h2>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
            <twig:UxDsfr:Tag>Tag par défaut</twig:UxDsfr:Tag>
            <twig:UxDsfr:Tag variant="success">Tag succès</twig:UxDsfr:Tag>
            <twig:UxDsfr:Tag variant="error">Tag erreur</twig:UxDsfr:Tag>
        </div>
    </div>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Code snippel</h3>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Tag&gt;Tag&lt;/twig:UxDsfr:Tag&gt;" %}
            <pre><code class="language-html">{{ code|raw }}</code></pre>
            {% set code = "&lt;twig:UxDsfr:Tag variant=\"success\"&gt;Tag&lt;/twig:UxDsfr:Tag&gt;" %}
            <pre><code class="language-html">{{ code|raw }}</code></pre>
        </div>
    </div>
{% endblock %}
