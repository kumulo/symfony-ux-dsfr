{% extends "@UxDsfr/demo/components.html.twig" %}

{% block text_content %}
    <h1 class="fr-h1">Highlight</h1>
    <div class="fr-mt-4v">
        <twig:UxDsfr:Callout color="blue-ecume">
            <p class="fr-mb-0">Le composant <code>Highlight</code> met en valeur un extrait de texte ou un message de mise en avant dans le design DSFR.</p>
        </twig:UxDsfr:Callout>
    </div>

<h2 class="fr-h3">Highlight</h2>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
            <twig:UxDsfr:Highlight>
                <p>Ceci est un texte mis en évidence.</p>
            </twig:UxDsfr:Highlight>
        </div>
    </div>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Code snippel</h3>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Highlight&gt;
    &lt;p&gt;Texte mis en évidence.&lt;/p&gt;
&lt;/twig:UxDsfr:Highlight&gt;" %}
            <pre><code class="language-html">{{ code|raw }}</code></pre>
        </div>
    </div>
{% endblock %}
