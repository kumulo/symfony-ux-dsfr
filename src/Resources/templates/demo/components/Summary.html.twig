{% extends "@UxDsfr/demo/components.html.twig" %}

{% block text_content %}
    <h2 class="fr-h3">Summary</h2>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
            <twig:UxDsfr:Summary title="Titre du résumé">
                <p>Contenu du résumé qui peut être déployé.</p>
            </twig:UxDsfr:Summary>
        </div>
    </div>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Code snippel</h3>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Summary title=\"Titre\"&gt;
    &lt;p&gt;Contenu.&lt;/p&gt;
&lt;/twig:UxDsfr:Summary&gt;" %}
            <pre><code class="language-html">{{ code|raw }}</code></pre>
        </div>
    </div>
{% endblock %}
