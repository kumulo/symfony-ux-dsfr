{% extends "@UxDsfr/demo/components.html.twig" %}

{% block text_content %}
    <h1 class="fr-h1">Callout</h1>
    <div class="fr-mt-4v">
        <twig:UxDsfr:Callout color="blue-ecume">
            <p class="fr-mb-0">Le composant <code>Callout</code> met en avant une information importante ou un message d’accompagnement visuellement distinct.</p>
        </twig:UxDsfr:Callout>
    </div>

    <h2 class="fr-h3">Rendu</h2>
    <div class="fr-mt-4v">
        <twig:UxDsfr:Callout>
            Ceci est un callout par défaut.
        </twig:UxDsfr:Callout>
    </div>
    <div class="fr-mt-4v">
        <p><strong>Code snippet</strong></p>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Callout&gt;
    Ceci est un callout par défaut.
&lt;/twig:UxDsfr:Callout&gt;" %}
            <twig:UxDsfr:Highlight><pre><code class="language-html">{{ code|raw }}</code></pre></twig:UxDsfr:Highlight>
        </div>
    </div>
    <h2 class="fr-h3">Couleurs disponibles</h2>
    <div class="fr-mt-4v">
        <div class="fr-mt-2v">
            <twig:UxDsfr:Callout color="green-emeraude">
                <strong>Vert Émeraude</strong> - Appelé à l'action positif ou informatif.
            </twig:UxDsfr:Callout>
        </div>
        <div class="fr-mt-2v">
            <twig:UxDsfr:Callout color="green-menthe">
                <strong>Vert Menthe</strong> - Appelé à l'action positif ou informatif.
            </twig:UxDsfr:Callout>
        </div>
        <div class="fr-mt-2v">
            <twig:UxDsfr:Callout color="purple-glycine">
                <strong>Violet Glycine</strong> - Callout avec une teinte pourpre.
            </twig:UxDsfr:Callout>
        </div>
        <div class="fr-mt-2v">
            <twig:UxDsfr:Callout color="pink-macaron">
                <strong>Rose Macaron</strong> - Callout avec une teinte rose.
            </twig:UxDsfr:Callout>
        </div>
        <div class="fr-mt-2v">
            <twig:UxDsfr:Callout color="yellow-tournesol">
                <strong>Jaune Tournesol</strong> - Avvertissement ou information importante.
            </twig:UxDsfr:Callout>
        </div>
        <div class="fr-mt-2v">
            <twig:UxDsfr:Callout color="orange-terre-battue">
                <strong>Orange Terre Battue</strong> - Mise en garde ou attention requise.
            </twig:UxDsfr:Callout>
        </div>
        <div class="fr-mt-2v">
            <twig:UxDsfr:Callout color="brown-cafe-creme">
                <strong>Marron Café Crème</strong> - Callout avec une teinte marron.
            </twig:UxDsfr:Callout>
        </div>
        <div class="fr-mt-2v">
            <twig:UxDsfr:Callout color="grey">
                <strong>Gris</strong> - Callout neutre ou désactivé.
            </twig:UxDsfr:Callout>
        </div>
    </div>
    <div class="fr-mt-4v">
        <p><strong>Code snippet</strong></p>
        <div class="code-snippet">
            {% set code2 = "&lt;twig:UxDsfr:Callout color=\"green-emeraude\" /&gt;
&lt;twig:UxDsfr:Callout color=\"green-menthe\" /&gt;
&lt;twig:UxDsfr:Callout color=\"blue-ecume\" /&gt;
&lt;twig:UxDsfr:Callout color=\"purple-glycine\" /&gt;
&lt;twig:UxDsfr:Callout color=\"pink-macaron\" /&gt;
&lt;twig:UxDsfr:Callout color=\"yellow-tournesol\" /&gt;
&lt;twig:UxDsfr:Callout color=\"orange-terre-battue\" /&gt;
&lt;twig:UxDsfr:Callout color=\"brown-cafe-creme\" /&gt;
&lt;twig:UxDsfr:Callout color=\"grey\" /&gt;" %}
            <twig:UxDsfr:Highlight><pre><code class="language-html">{{ code2|raw }}</code></pre></twig:UxDsfr:Highlight>
        </div>
    </div>
{% endblock %}
