{% extends "@UxDsfr/demo/components.html.twig" %}

{% block text_content %}
    <h2 class="fr-h3">Badge</h2>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
            <h4 class="fr-h5">Types</h4>
            <div class="fr-mt-2v">
                <twig:UxDsfr:Badge type="info" content="Info"/>
                <twig:UxDsfr:Badge type="warning" content="Warning"/>
                <twig:UxDsfr:Badge type="error" content="Error"/>
                <twig:UxDsfr:Badge type="success" content="Success"/>
            </div>
        </div>
        <div class="fr-mt-4v">
            <h4 class="fr-h5">Tailles</h4>
            <div class="fr-mt-2v">
                <twig:UxDsfr:Badge size="sm" content="Small"/>
                <twig:UxDsfr:Badge size="md" content="Medium"/>
                <twig:UxDsfr:Badge size="lg" content="Large"/>
            </div>
        </div>
        <div class="fr-mt-4v">
            <h4 class="fr-h5">Combinaisons</h4>
            <div class="fr-mt-2v">
                <twig:UxDsfr:Badge type="success" size="sm" content="✓ Succès"/>
                <twig:UxDsfr:Badge type="warning" size="md" content="⚠ Attention"/>
                <twig:UxDsfr:Badge type="error" size="lg" content="✕ Erreur"/>
            </div>
        </div>
    </div>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Exemples de code</h3>
        <div class="code-snippet">
            <h4 class="fr-h5">Type par défaut (info)</h4>
            {% set code1 = "&lt;twig:UxDsfr:Badge content=\"Info\" /&gt;" %}
            <pre><code class="language-html">{{ code1|raw }}</code></pre>

            <h4 class="fr-h5">Avec type et taille</h4>
            {% set code2 = "&lt;twig:UxDsfr:Badge type=\"success\" size=\"md\" content=\"✓ Succès\" /&gt;" %}
            <pre><code class="language-html">{{ code2|raw }}</code></pre>

            <h4 class="fr-h5">Tous les types disponibles</h4>
            {% set code3 = "&lt;twig:UxDsfr:Badge type=\"info\" content=\"Info\" /&gt;
&lt;twig:UxDsfr:Badge type=\"warning\" content=\"Warning\" /&gt;
&lt;twig:UxDsfr:Badge type=\"error\" content=\"Error\" /&gt;
&lt;twig:UxDsfr:Badge type=\"success\" content=\"Success\" /&gt;" %}
            <pre><code class="language-html">{{ code3|raw }}</code></pre>

            <h4 class="fr-h5">Toutes les tailles disponibles</h4>
            {% set code4 = "&lt;twig:UxDsfr:Badge size=\"sm\" content=\"Small\" /&gt;
&lt;twig:UxDsfr:Badge size=\"md\" content=\"Medium\" /&gt;
&lt;twig:UxDsfr:Badge size=\"lg\" content=\"Large\" /&gt;" %}
            <pre><code class="language-html">{{ code4|raw }}</code></pre>
        </div>
    </div>
{% endblock %}

