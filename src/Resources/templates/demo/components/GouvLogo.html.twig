{% extends "@UxDsfr/demo/components.html.twig" %}

{% block text_content %}
    <h1 class="fr-h1">GouvLogo</h1>
    <div class="fr-mt-4v">
        <twig:UxDsfr:Callout color="blue-ecume">
            <p class="fr-mb-0">Le composant <code>GouvLogo</code> affiche le logo institutionnel sur le style DSFR et s’adapte aux usages de marque.</p>
        </twig:UxDsfr:Callout>
    </div>

<h2 class="fr-h3">GouvLogo</h2>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
                <twig:UxDsfr:GouvLogo />
        </div>
    </div>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Code snippel</h3>
        <div class="code-snippet">
            {% set code = "{% component 'UxDsfr:GouvLogo' %}
    {% block content %}
        Intitulé&lt;br&gt;officiel
    {% endblock %}
{% endcomponent %}" %}
            <pre><code class="language-twig">{{ code|raw }}</code></pre>
            {% set code = "&lt;twig:UxDsfr:GouvLogo&gt;
    Intitulé&lt;br&gt;officiel
&lt;/twig:UxDsfr:GouvLogo&gt;" %}
            <pre><code class="language-html">{{ code|raw }}</code></pre>
        </div>
    </div>
{% endblock %}
