{% extends "@UxDsfr/demo/components.html.twig" %}

{% block text_content %}
    <h1 class="fr-h1">Card</h1>
    <div class="fr-mt-4v">
        <twig:UxDsfr:Callout color="blue-ecume">
            <p class="fr-mb-0">Le composant <code>Card</code> présente une ressource, une information ou un document avec une structure de carte DSFR.</p>
        </twig:UxDsfr:Callout>
    </div>

<div class="fr-mt-4v">
    <h2 class="fr-h3">Rendu de base</h2>
    <div class="fr-mt-4v">
        <div class="fr-mt-2v">
            <twig:UxDsfr:Card>
                <p class="fr-card__desc">Description de la carte de base.</p>
            </twig:UxDsfr:Card>
        </div>
    </div>
    <div class="fr-mt-4v">
        <p><strong>Code snippet</strong></p>
        {% set code = "&lt;twig:UxDsfr:Card&gt;
    &lt;p class=\"fr-card__desc\"&gt;Description de la carte.&lt;/p&gt;
&lt;/twig:UxDsfr:Card&gt;" %}
            <twig:UxDsfr:Highlight><pre><code class="language-twig">{{ code|raw }}</code></pre></twig:UxDsfr:Highlight>
        </div>
    </div>
    <h2 class="fr-h3 fr-mt-8v">Ajout d'un titre et d'un lien</h2>
    <div class="fr-mt-4v">
        <div class="fr-mt-2v">
            <twig:UxDsfr:Card href="#">
                {% block card_title %}Ma première carte{% endblock %}
                {% block content %}
                    <p class="fr-card__desc">Cette carte possède un titre et un lien.</p>
                {% endblock %}
            </twig:UxDsfr:Card>
        </div>
    </div>
    <div class="fr-mt-4v">
        <p><strong>Code snippet</strong></p>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Card href=\"#\" link_type=\"fr-enlarge-link\"&gt;
    {% block card_title %}Ma première carte{% endblock %}
    {% block content %}
        &lt;p class=\"fr-card__desc\"&gt;Cette carte possède un titre et un lien.&lt;/p&gt;
    {% endblock %}
&lt;/twig:UxDsfr:Card&gt;" %}
            <twig:UxDsfr:Highlight><pre><code class="language-twig">{{ code|raw }}</code></pre></twig:UxDsfr:Highlight>
        </div>
    </div>

    <h2 class="fr-h3 fr-mt-8v">Carte avec image</h2>
    <div class="fr-mt-4v">
        <div class="fr-mt-2v">
            <twig:UxDsfr:Card
                href="#"
                card_header="/bundles/symfonyuxdsfr/images/placeholder.16x9.png"
                card_header_alt="Description de l'image">
                {% block card_title %}Carte avec illustration{% endblock %}
                {% block content %}
                    <p class="fr-card__desc">Cette carte possède une image d'illustration en en-tête.</p>
                {% endblock %}
            </twig:UxDsfr:Card>
        </div>
    </div>
    <div class="fr-mt-4v">
        <p><strong>Code snippet</strong></p>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Card
    href=\"#\"
    card_header=\"/path/to/image.jpg\"
    card_header_alt=\"Description de l'image\"&gt;
    {% block card_title %}Titre de la carte{% endblock %}
    {% block content %}
        &lt;p class=\"fr-card__desc\"&gt;Description du contenu.&lt;/p&gt;
    {% endblock %}
&lt;/twig:UxDsfr:Card&gt;" %}
            <twig:UxDsfr:Highlight><pre><code class="language-twig">{{ code|raw }}</code></pre></twig:UxDsfr:Highlight>
        </div>
    </div>

    <h2 class="fr-h3 fr-mt-8v">Carte horizontale avec image</h2>
    <div class="fr-mt-4v">
        <div class="fr-mt-2v">
            <twig:UxDsfr:Card
                href="#"
                card_header="/bundles/symfonyuxdsfr/images/placeholder.16x9.png"
                card_header_alt="Description de l'image"
                horizontal="true">
                {% block card_title %}Carte horizontale avec illustration{% endblock %}
                {% block content %}
                    <p class="fr-card__desc">Cette carte est affichée en mode horizontal avec une image d'illustration.</p>
                {% endblock %}
            </twig:UxDsfr:Card>
        </div>
    </div>
    <div class="fr-mt-4v">
        <p><strong>Code snippet</strong></p>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Card
    href=\"#\"
    card_header=\"/path/to/image.jpg\"
    card_header_alt=\"Description de l'image\"
    horizontal=\"true\"&gt;
    {% block card_title %}Carte horizontale avec illustration{% endblock %}
    {% block content %}
        &lt;p class=\"fr-card__desc\"&gt;Description du contenu.&lt;/p&gt;
    {% endblock %}
&lt;/twig:UxDsfr:Card&gt;" %}
            <twig:UxDsfr:Highlight><pre><code class="language-twig">{{ code|raw }}</code></pre></twig:UxDsfr:Highlight>
        </div>
    </div>

    <h2 class="fr-h3 fr-mt-8v">Carte de type téléchargement (horizontal)</h2>
    <div class="fr-mt-4v">
        <div class="fr-mt-2v">
            <twig:UxDsfr:Card
                href="#"
                card_header="/bundles/symfonyuxdsfr/images/placeholder.16x9.png"
                download="true"
                file_type="PDF"
                file_size="2.5 MB">
                {% block card_title %}Document à télécharger{% endblock %}
                {% block content %}
                    <p class="fr-card__desc">Téléchargez ce document important.</p>
                {% endblock %}
            </twig:UxDsfr:Card>
        </div>
    </div>
    <div class="fr-mt-4v">
        <p><strong>Code snippet</strong></p>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Card
    href=\"#\"
    card_header=\"/path/to/image.jpg\"
    card_header_alt=\"Description de l'image\"
    download=\"true\"
    file_type=\"PDF\"
    file_size=\"2.5 MB\"&gt;
    {% block card_title %}Carte de type téléchargement{% endblock %}
    {% block content %}
        &lt;p class=\"fr-card__desc\"&gt;Description du contenu.&lt;/p&gt;
    {% endblock %}
&lt;/twig:UxDsfr:Card&gt;" %}
            <twig:UxDsfr:Highlight><pre><code class="language-twig">{{ code|raw }}</code></pre></twig:UxDsfr:Highlight>
        </div>
    </div>
    <h2 class="fr-h3 fr-mt-8v">Exemple d'une grille de cartes</h2>

    <div class="fr-mt-4v">
        <div class="fr-mt-2v fr-grid-row fr-grid-row--gutters">
            <div class="fr-col-12 fr-col-md-4">
                <twig:UxDsfr:Card href="#"
                  card_header="/bundles/symfonyuxdsfr/images/placeholder.16x9.png"
                  card_header_alt="Description de l'image">
                    {% block card_title %}Carte 1{% endblock %}
                    {% block content %}
                        <p class="fr-card__desc">Première colonne de contenu.</p>
                    {% endblock %}
                </twig:UxDsfr:Card>
            </div>
            <div class="fr-col-12 fr-col-md-4">
                <twig:UxDsfr:Card href="#"
                  card_header="/bundles/symfonyuxdsfr/images/placeholder.16x9.png"
                  card_header_alt="Description de l'image">
                    {% block card_title %}Carte 2{% endblock %}
                    {% block content %}
                        <p class="fr-card__desc">Deuxième colonne de contenu.</p>
                    {% endblock %}
                </twig:UxDsfr:Card>
            </div>
            <div class="fr-col-12 fr-col-md-4">
                <twig:UxDsfr:Card href="#"
                  card_header="/bundles/symfonyuxdsfr/images/placeholder.16x9.png"
                  card_header_alt="Description de l'image">
                    {% block card_title %}Carte 3{% endblock %}
                    {% block content %}
                        <p class="fr-card__desc">Troisième colonne de contenu.</p>
                    {% endblock %}
                </twig:UxDsfr:Card>
            </div>
        </div>
    </div>
</div>
{% endblock %}

