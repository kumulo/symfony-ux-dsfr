{% extends "@UxDsfr/demo/components.html.twig" %}

{% block text_content %}
    <h1 class="fr-h1">Button</h1>
    <div class="fr-mt-4v">
        <twig:UxDsfr:Callout color="blue-ecume">
            <p class="fr-mb-0">Le composant <code>Button</code> rend un appel à l’action DSFR compatible avec les variantes de bouton et les liens.</p>
        </twig:UxDsfr:Callout>
    </div>

<div class="fr-mt-4v">
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
            <twig:UxDsfr:Button>
                Bouton primaire
            </twig:UxDsfr:Button>
            <twig:UxDsfr:Button variant="secondary">
                Bouton secondaire
            </twig:UxDsfr:Button>
            <twig:UxDsfr:Button variant="tertiary">
                Bouton tertiaire
            </twig:UxDsfr:Button>
            <twig:UxDsfr:Button href="#link">
                Bouton lien
            </twig:UxDsfr:Button>
        </div>
    </div>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Code snippel</h3>
        <div class="code-snippet">
            {% set code = "&lt;twig:UxDsfr:Button&gt;
    Bouton primaire
&lt;/twig:UxDsfr:Button&gt;" %}
            <pre><code class="language-html">{{ code|raw }}</code></pre>
            {% set code = "&lt;twig:UxDsfr:Button variant=\"secondary\" href=\"#link\"&gt;
    Bouton secondaire lien
&lt;/twig:UxDsfr:Button&gt;" %}
            <pre><code class="language-html">{{ code|raw }}</code></pre>
        </div>
    </div>
{% endblock %}
