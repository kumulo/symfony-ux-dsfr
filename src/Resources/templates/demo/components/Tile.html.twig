{% extends "@UxDsfr/demo/components.html.twig" %}

{% block text_content %}
    <h2 class="fr-h3">Tile</h2>
    <div class="fr-mt-4v">
        <h3 class="fr-h4">Rendu</h3>
        <div class="fr-mt-4v">
            <h4 class="fr-h5">Tuile standard (clickable)</h4>
            <div class="fr-mt-2v">
                <twig:UxDsfr:Tile href="#" title="Titre de la tuile" desc="Description de la tuile">
                    {% block body %}
                    <p>Contenu supplémentaire.</p>
                    {% endblock %}
                    {% block header %}
                    <div class="fr-tile__pictogram">
                        <svg aria-hidden="true" class="fr-artwork" viewBox="0 0 80 80" width="80" height="80">
                            <use class="fr-artwork-decorative" href="/bundles/symfonyuxdsfr/artwork/pictograms/buildings/city-hall.svg#artwork-decorative"></use>
                            <use class="fr-artwork-minor" href="/bundles/symfonyuxdsfr/artwork/pictograms/buildings/city-hall.svg#artwork-minor"></use>
                            <use class="fr-artwork-major" href="/bundles/symfonyuxdsfr/artwork/pictograms/buildings/city-hall.svg#artwork-major"></use>
                        </svg>
                    </div>
                    {% endblock %}
                </twig:UxDsfr:Tile>
            </div>

            <h4 class="fr-h5 fr-mt-4v">Tuile non‑clickable (div)</h4>
            <div class="fr-mt-2v">
                <twig:UxDsfr:Tile title="Tuile statique" desc="Ne contient pas de lien">
                    {% block body %}
                    <p>Contenu statique.</p>
                    {% endblock %}
                </twig:UxDsfr:Tile>
            </div>

            <h4 class="fr-h5 fr-mt-4v">Orientation verticale</h4>
            <div class="fr-mt-2v">
                <twig:UxDsfr:Tile orientation="vertical" href="#" title="Vertical" desc="Orientation verticale">
                    {% block body %}
                    <p>Tuile verticale avec pictogramme.</p>
                    {% endblock %}
                    {% block header %}
                    <div class="fr-tile__pictogram">
                        <svg aria-hidden="true" class="fr-artwork" viewBox="0 0 80 80" width="80" height="80">
                            <use class="fr-artwork-decorative" href="/bundles/symfonyuxdsfr/artwork/pictograms/system/information.svg#artwork-decorative"></use>
                            <use class="fr-artwork-minor" href="/bundles/symfonyuxdsfr/artwork/pictograms/system/information.svg#artwork-minor"></use>
                            <use class="fr-artwork-major" href="/bundles/symfonyuxdsfr/artwork/pictograms/system/information.svg#artwork-major"></use>
                        </svg>
                    </div>
                    {% endblock %}
                </twig:UxDsfr:Tile>
            </div>

            <h4 class="fr-h5 fr-mt-4v">Grille responsive de tuiles</h4>
            <div class="fr-mt-2v fr-grid-row fr-grid-row--gutters">
                <div class="fr-col-12 fr-col-md-4">
                    <twig:UxDsfr:Tile href="#" title="Tuile 1" desc="Desc 1"></twig:UxDsfr:Tile>
                </div>
                <div class="fr-col-12 fr-col-md-4">
                    <twig:UxDsfr:Tile href="#" title="Tuile 2" desc="Desc 2"></twig:UxDsfr:Tile>
                </div>
                <div class="fr-col-12 fr-col-md-4">
                    <twig:UxDsfr:Tile href="#" title="Tuile 3" desc="Desc 3"></twig:UxDsfr:Tile>
                </div>
            </div>
        </div>
    </div>

    <div class="fr-mt-4v">
        <h3 class="fr-h4">Exemples de code</h3>
        <div class="code-snippet">
            <h4 class="fr-h5">Tuile clickable</h4>
            {% set code1 = "&lt;twig:UxDsfr:Tile href=\"#\" title=\"Titre\" desc=\"Description\"&gt;\n    {% block body %}\n    &lt;p&gt;Contenu&lt;/p&gt;\n    {% endblock %}\n&lt;/twig:UxDsfr:Tile&gt;" %}
            <pre><code class="language-html">{{ code1|raw }}</code></pre>

            <h4 class="fr-h5">Tuile non‑clickable</h4>
            {% set code2 = "&lt;twig:UxDsfr:Tile title=\"Statique\" desc=\"Sans lien\" /&gt;" %}
            <pre><code class="language-html">{{ code2|raw }}</code></pre>

            <h4 class="fr-h5">Tuile verticale</h4>
            {% set code3 = "&lt;twig:UxDsfr:Tile orientation=\"vertical\" href=\"#\" title=\"Vertical\" desc=\"Desc\" /&gt;" %}
            <pre><code class="language-html">{{ code3|raw }}</code></pre>
        </div>
    </div>
{% endblock %}
