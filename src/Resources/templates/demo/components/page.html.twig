{% set page_content %}
    <twig:UxDsfr:Header
            header_service_title="Symfony UX DSFR"
            header_service_tag="Implémentation du DSFR dans Symfony"
    >
    </twig:UxDsfr:Header>
    {% if block('body_content') is defined %}
    {% set body = block('body_content') %}
    <twig:UxDsfr:Layout:Body class="fr-pb-md-14v">
        {% block body_content %}
            {{ body|raw }}
        {% endblock %}
    </twig:UxDsfr:Layout:Body>
    {% endif %}
    <twig:UxDsfr:Footer />
{% endset %}
<twig:UxDsfr:Layout:Page>
    {% block stylesheets %}
        {{ parent() }}
        {{ encore_entry_link_tags('dsfr-demo', null, 'dsfr') }}
    {% endblock %}
    {% block javascripts %}
        {{ parent() }}
        {{ encore_entry_script_tags('dsfr-demo', null, 'dsfr') }}
    {% endblock %}
    {% block page %}
    {{ page_content }}
    {% endblock %}
</twig:UxDsfr:Layout:Page>
