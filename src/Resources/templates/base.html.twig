<!DOCTYPE html>
<html lang="{{ app.request.locale }}" data-fr-theme="light" data-fr-scheme="light">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    {% block favicon %}{{ include('@UxDsfr/favicon.html.twig') }}{% endblock %}

    {% block stylesheets %}
        {{ block('stylesheets', '@UxDsfr/assets/' ~ ux_dsfr_integration_mode ~ '.html.twig') }}
    {% endblock %}

    {% block javascripts %}
        {{ block('javascripts', '@UxDsfr/assets/' ~ ux_dsfr_integration_mode ~ '.html.twig') }}
    {% endblock %}

    {% block head_meta %}{% endblock %}
</head>
<body>
{% block page_content %}{% endblock %}
</body>
</html>
