{# DSFR favicon (fondamentaux/icone-de-favori), from the bundle's public directory #}
<link rel="apple-touch-icon" href="{{ asset('bundles/symfonyuxdsfr/favicon/apple-touch-icon.png') }}"><!-- 180×180 -->
<link rel="icon" href="{{ asset('bundles/symfonyuxdsfr/favicon/favicon.svg') }}" type="image/svg+xml">
